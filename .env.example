# =============================================================================
# AsiFin — Environment Configuration
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — set these before first boot
# -----------------------------------------------------------------------------

# JWT signing key — minimum 32 characters, use a cryptographically random string.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_minimum_32_characters_random_secret

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
DEBUG=true                       # false in production

# API prefix (default is fine, change only if you have routing constraints)
API_V1_STR=/api/v1

# Set false in production — disables destructive admin commands
ALLOW_ADMIN_COMMANDS=false

# -----------------------------------------------------------------------------
# LLM Provider
# Options: mock | local_qwen | openai
#
# mock        — zero-cost, deterministic responses (for dev/testing)
# local_qwen  — uses Ollama with Qwen 2.5 7B (requires ollama service)
# openai      — uses OpenAI API (requires OPENAI_API_KEY)
# -----------------------------------------------------------------------------

ACTIVE_MODEL_PROVIDER=mock

# OpenAI settings (required if ACTIVE_MODEL_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (future use)
ANTHROPIC_API_KEY=

# Ollama settings (required if ACTIVE_MODEL_PROVIDER=local_qwen)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen3-vl:2b-thinking

# -----------------------------------------------------------------------------
# PostgreSQL
# In Docker Compose, POSTGRES_HOST should be "db" (the service name)
# -----------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asifin

# -----------------------------------------------------------------------------
# Redis
# In Docker Compose, use: redis://redis:6379
# -----------------------------------------------------------------------------

REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Qdrant (vector database)
# In Docker Compose, use host=qdrant port=6333
# -----------------------------------------------------------------------------

QDRANT_HOST=localhost
QDRANT_PORT=6555
QDRANT_COLLECTION=financial_docs

# -----------------------------------------------------------------------------
# RAG (Retrieval-Augmented Generation)
# -----------------------------------------------------------------------------

# Number of candidate chunks retrieved before reranking
RAG_RETRIEVE_TOP_K=20

# Embedding reranking (improves result quality, slight latency cost)
RAG_ENABLE_RERANK=true

# Cross-encoder reranking (higher quality, significant latency cost — off by default)
RAG_ENABLE_CROSS_ENCODER_RERANK=false
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Embedding model (CPU-efficient, runs in-process via FastEmbed)
EMBEDDING_MODEL=mxbai-embed-large

# Chunking parameters per document type
RAG_CHUNK_SIZE_DEFAULT=1000
RAG_CHUNK_OVERLAP_DEFAULT=200
RAG_CHUNK_SIZE_TABLE=500
RAG_CHUNK_OVERLAP_TABLE=80
RAG_CHUNK_SIZE_TEXT=1000
RAG_CHUNK_OVERLAP_TEXT=200
RAG_CHUNK_SIZE_IMAGE=700
RAG_CHUNK_OVERLAP_IMAGE=100

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------

ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------------------------------------------------------------------
# Migration (Docker only)
# Controls retry behavior for alembic upgrade head on container startup
# -----------------------------------------------------------------------------

MIGRATION_RETRIES=30
MIGRATION_RETRY_DELAY=2
